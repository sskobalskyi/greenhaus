{
    "realm":  "greenhaus",
    "displayName":  "Greenhaus",
    "enabled":  true,
    "registrationAllowed":  true,
    "registrationEmailAsUsername":  false,
    "loginWithEmailAllowed":  true,
    "duplicateEmailsAllowed":  false,
    "resetPasswordAllowed":  true,
    "sslRequired":  "none",
    "internationalizationEnabled":  true,
    "supportedLocales":  [
                             "en",
                             "uk"
                         ],
    "defaultLocale":  "en",
    "clients":  [
                    {
                        "clientId":  "greenhaus-web",
                        "name":  "Greenhaus web app",
                        "enabled":  true,
                        "publicClient":  true,
                        "standardFlowEnabled":  true,
                        "directAccessGrantsEnabled":  false,
                        "redirectUris":  [
                                             "http://localhost:5174/*",
                                             "http://localhost:4173/*"
                                         ],
                        "webOrigins":  [
                                           "http://localhost:5174",
                                           "http://localhost:4173"
                                       ],
                        "attributes":  {
                                           "pkce.code.challenge.method":  "S256",
                                           "post.logout.redirect.uris":  "http://localhost:5174/*##http://localhost:4173/*"
                                       },
                        "protocolMappers":  [
                                                {
                                                    "name":  "greenhaus-api audience",
                                                    "protocol":  "openid-connect",
                                                    "protocolMapper":  "oidc-audience-mapper",
                                                    "consentRequired":  false,
                                                    "config":  {
                                                                   "included.client.audience":  "greenhaus-api",
                                                                   "id.token.claim":  "false",
                                                                   "access.token.claim":  "true"
                                                               }
                                                }
                                            ]
                    },
                    {
                        "clientId":  "greenhaus-api",
                        "name":  "Greenhaus API",
                        "enabled":  true,
                        "bearerOnly":  true
                    },
                    {
                        "clientId":  "orderflow-web",
                        "name":  "Orderflow web",
                        "enabled":  true,
                        "publicClient":  true,
                        "standardFlowEnabled":  true,
                        "directAccessGrantsEnabled":  true,
                        "redirectUris":  [
                                             "http://localhost:5173/*"
                                         ],
                        "webOrigins":  [
                                           "http://localhost:5173"
                                       ],
                        "attributes":  {
                                           "pkce.code.challenge.method":  "S256",
                                           "post.logout.redirect.uris":  "+"
                                       },
                        "protocolMappers":  [
                                                {
                                                    "name":  "realm roles",
                                                    "protocol":  "openid-connect",
                                                    "protocolMapper":  "oidc-usermodel-realm-role-mapper",
                                                    "config":  {
                                                                   "claim.name":  "roles",
                                                                   "jsonType.label":  "String",
                                                                   "multivalued":  "true",
                                                                   "access.token.claim":  "true",
                                                                   "id.token.claim":  "false",
                                                                   "userinfo.token.claim":  "false"
                                                               }
                                                }
                                            ]
                    },
                    {
                        "clientId":  "pulse-web",
                        "name":  "Pulse dashboard and API explorers",
                        "enabled":  true,
                        "publicClient":  true,
                        "standardFlowEnabled":  true,
                        "directAccessGrantsEnabled":  true,
                        "redirectUris":  [
                                             "http://localhost:5173/*",
                                             "http://localhost:8080/*"
                                         ],
                        "webOrigins":  [
                                           "http://localhost:5173",
                                           "http://localhost:8080"
                                       ],
                        "attributes":  {
                                           "pkce.code.challenge.method":  "S256",
                                           "post.logout.redirect.uris":  "+"
                                       }
                    },
                    {
                        "clientId":  "pulse-service",
                        "name":  "Pulse service caller (client credentials)",
                        "enabled":  true,
                        "publicClient":  false,
                        "secret":  "pulse-dev-secret",
                        "serviceAccountsEnabled":  true,
                        "standardFlowEnabled":  false,
                        "directAccessGrantsEnabled":  false
                    }
                ],
    "users":  [
                  {
                      "username":  "demo",
                      "email":  "demo@greenhaus.local",
                      "firstName":  "Demo",
                      "lastName":  "Gardener",
                      "enabled":  true,
                      "emailVerified":  true,
                      "credentials":  [
                                          {
                                              "type":  "password",
                                              "value":  "demo",
                                              "temporary":  false
                                          }
                                      ]
                  },
                  {
                      "username":  "admin",
                      "email":  "admin@greenhaus.local",
                      "firstName":  "Admin",
                      "lastName":  "Local",
                      "enabled":  true,
                      "emailVerified":  true,
                      "credentials":  [
                                          {
                                              "type":  "password",
                                              "value":  "admin",
                                              "temporary":  false
                                          }
                                      ],
                      "realmRoles":  [
                                         "admin"
                                     ]
                  },
                  {
                      "username":  "alice",
                      "email":  "alice@greenhaus.local",
                      "firstName":  "Alice",
                      "lastName":  "Local",
                      "enabled":  true,
                      "emailVerified":  true,
                      "credentials":  [
                                          {
                                              "type":  "password",
                                              "value":  "alice",
                                              "temporary":  false
                                          }
                                      ]
                  },
                  {
                      "username":  "bob",
                      "email":  "bob@greenhaus.local",
                      "firstName":  "Bob",
                      "lastName":  "Local",
                      "enabled":  true,
                      "emailVerified":  true,
                      "credentials":  [
                                          {
                                              "type":  "password",
                                              "value":  "bob",
                                              "temporary":  false
                                          }
                                      ]
                  },
                  {
                      "username":  "service-account-pulse-service",
                      "enabled":  true,
                      "serviceAccountClientId":  "pulse-service",
                      "realmRoles":  [
                                         "pulse-service"
                                     ]
                  }
              ],
    "roles":  {
                  "realm":  [
                                {
                                    "name":  "admin",
                                    "description":  "Orderflow administrator (ships orders, refunds)"
                                },
                                {
                                    "name":  "pulse-service",
                                    "description":  "Service caller of the Pulse device API (registry, claim, retire)"
                                }
                            ]
              }
}