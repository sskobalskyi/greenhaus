# Docs-Brain for the ecosystem: offline mock AI instead of Ollama (no model download), and it accepts the service token
# of the shared realm. Used as --env-file, which replaces Docs-Brain's own .env (that one turns the llm profile on).
COMPOSE_PROFILES=
AI_PROVIDER=mock
SEARCH_MIN_SIMILARITY=0.2
AUTH_AUTHORITY=http://host.docker.internal:8181/realms/greenhaus
AUTH_ISSUER=http://localhost:8181/realms/greenhaus